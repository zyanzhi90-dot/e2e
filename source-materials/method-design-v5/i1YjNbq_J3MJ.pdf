ame":"General Topics for Engineers"},{"name":"Robotics and Control Systems"},{"name":"Signal Processing and Analysis"},{"name":"Transportation"}],"publisher":"IEEE","isSpringer":false,"isChapter":false,"isEphemera":false,"isConference":true,"displayDocTitle":"Robot-Safe Impacts with Soft Contacts Based on Learned Deformations","isOnlineOnly":false,"isStandard":false,"xploreDocumentType":"Conference Publication","isJournal":false,"isDynamicHtml":true,"isBookWithoutChapters":false,"isProduct":false,"isTutorial":false,"isEarlyAccess":false,"isOpenAccess":false,"isFreeDocument":false,"isBook":false,"isPromo":false,"isNow":false,"isDegruyter":false,"isSMPTE":false,"isOUP":false,"htmlLink":"/document/9561678/","htmlAbstractLink":"/document/9561678/","isLatestStandard":false,"hasStandardVersions":false,"isGiveaway":false,"isTranslation":false,"isSAE":false,"isCustomDenial":false,"persistentLink":"https://xplorestaging.ieee.org/servlet/opac?punumber=9560720","startPage":"1357","articleCopyRight":"2021 IEEE","openAccessFlag":"F","insertDate":"18 October 2021","ephemeraFlag":"false","title":"Robot-Safe Impacts with Soft Contacts Based on Learned Deformations","confLoc":"Xi'an, China","html_flag":"false","ml_html_flag":"true","sourcePdf":"3497.pdf","displayPublicationDate":"30 May 2021 - 05 June 2021","mlTime":"PT0.053991S","xplore-pub-id":"9560720","pdfPath":"/iel7/9560720/9560666/09561678.pdf","isNumber":"9560666","rightsLinkFlag":"1","contentType":"conferences","publicationDate":"30 May 2021","publicationNumber":"9560720","citationCount":"10","xplore-issue":"9560666","articleId":"9561678","publicationTitle":"2021 IEEE International Conference on Robotics and Automation (ICRA)","sections":{"abstract":"true","authors":"true","disclaimer":"false","figures":"true","multimedia":"true","references":"true","citedby":"true","keywords":"true","definitions":"false","algorithm":"false","dataset":"false","cadmore":"false","footnotes":"true","relatedContent":"false","metrics":"true"},"contentTypeDisplay":"Conferences","referenceCount":33,"publicationYear":"2021","subType":"IEEE Conference","_value":"IEEE","lastupdate":"2026-08-09","mediaPath":"/mediastore/IEEE/content/media/9560720/9560666/9561678","endPage":"1363","displayPublicationTitle":"2021 IEEE International Conference on Robotics and Automation (ICRA)","doi":"10.1109/ICRA48506.2021.9561678"};








</script>



